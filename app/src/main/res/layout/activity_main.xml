<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Готов. Нажмите «Запустить стрим»"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Web-панель: http://?/"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:paddingBottom="8dp" />

        <!-- ★ Профиль камеры: влияет ТОЛЬКО на параметры SET_ALL_SETTINGS / START_LIVE_VIEW,
             отправляемые камере перед стартом. Механизм трансляции — всегда WebRTC. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Профиль камеры:"
            android:textStyle="bold"
            android:paddingTop="4dp" />

        <Spinner
            android:id="@+id/spinnerStreamProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Web-порт -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTP-порт (Web-панель):" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="8080"
                android:fontFamily="monospace"/>

            <Button
                android:id="@+id/btnApplyPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Применить"/>
        </LinearLayout>

        <!-- Photo resolution (JPEG) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photo resolution (JPEG):" />

        <Spinner
            android:id="@+id/spinnerPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Video resolution (live H.264 stream) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video resolution (live stream):" />

        <Spinner
            android:id="@+id/spinnerVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Основная кнопка — ВСЕГДА WebRTC -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ ЗАПУСТИТЬ СТРИМ (WebRTC)"
            android:textStyle="bold" />

        <!-- Необязательная отдельная опция локального предпросмотра (не влияет на трансляцию) -->
        <Button
            android:id="@+id/btnStartFlat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Локальный просмотр FLAT 360×180" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="■ Стоп" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Настройки Android" />

        <Button
            android:id="@+id/btnLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки Launcher (HOME)" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⚠️ ВКЛЮЧИТЕ АВТО-ПОДТВЕРЖДЕНИЕ USB" />

    </LinearLayout>
</ScrollView>